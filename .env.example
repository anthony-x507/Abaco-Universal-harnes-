# Copy to .env and fill in. Never commit real secrets.
# All three are required for live completions (`universal ask` / `universal chat`).

UNIVERSAL_LLM_BASE_URL=https://api.openai.com/v1
UNIVERSAL_LLM_API_KEY=
UNIVERSAL_LLM_MODEL=gpt-4o-mini

# Optional
# UNIVERSAL_LLM_TIMEOUT=60
# UNIVERSAL_LLM_ORGANIZATION=

# Serve identity snapshot (not a second registry; no history, no API keys).
# Empty value keeps the in-memory registry only. Default is user-data registry.json.
# UNIVERSAL_REGISTRY_FILE=

# HTTP factory server: python3 -m universal serve --host 127.0.0.1 --port 43124
# SPA (from web/): bun install && bun run dev  →  http://127.0.0.1:43123
# Demo without a live key: python3 -m universal serve --demo
